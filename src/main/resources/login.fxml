<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.controller.LoginController">
    <padding>
        <Insets top="50" right="50" bottom="50" left="50"/>
    </padding>

    <Label text="Chat Application" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <VBox spacing="10">
        <Label text="Enter your username:"/>
        <TextField fx:id="usernameField" promptText="Username"/>
    </VBox>

    <Button text="Join Chat" onAction="#handleLogin"
            style="-fx-font-size: 14px; -fx-padding: 10 20 10 20;"/>
</VBox>